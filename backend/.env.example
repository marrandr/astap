# ── Base de données ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astap?schema=public"

# ── JWT ─────────────────────────────────────────────────────────
# OBLIGATOIRE en production : longue chaîne aléatoire.
JWT_SECRET="change-me-with-a-long-random-string"

# ── Serveur ─────────────────────────────────────────────────────
PORT=3001
# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# Swagger sur /api : activé hors production, ou si SWAGGER_ENABLED=true
# SWAGGER_ENABLED=true

# Rate limiting global (optionnel)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
AIORNOT_API_KEY=""

# ── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hamarino <no-reply@hamarino.io>"
